POSTGRES_USER=automation
POSTGRES_PASSWORD=automation
POSTGRES_DB=automation
DATABASE_URL=postgresql+psycopg://automation:automation@db:5432/automation
ADMIN_PASSWORD=admin
SEED_LOCAL=true
# Frontend API URL is compiled into the frontend image. Local Compose supplies
# http://localhost:8000; leave empty in production when /api is routed to the API.
UPLOADS_DIR=/app/uploads
