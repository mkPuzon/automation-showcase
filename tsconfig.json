{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// #lib/* is also declared in package.json "imports" (that's what Vite/Rollup read); these
		// entries exist so svelte-check/TS resolve the same specifiers.
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"],
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
